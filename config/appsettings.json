{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AccountingSystemDb;Trusted_Connection=true;MultipleActiveResultSets=true",
    "SqlServer": "Server=.;Database=AccountingSystemDb;Integrated Security=true;MultipleActiveResultSets=true",
    "MySql": "Server=localhost;Database=accounting_system;User=root;Password=password"
  },
  "ApplicationSettings": {
    "AppName": "Accounting System",
    "Version": "1.0.0",
    "Culture": "ar-SA",
    "Currency": "SAR"
  },
  "Features": {
    "EnableArabicSupport": true,
    "EnableReporting": true,
    "EnableMultiLanguage": true,
    "EnableAuditLog": true
  },
  "AllowedHosts": "*"
}
